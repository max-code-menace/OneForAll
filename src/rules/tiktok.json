{
  "schemaVersion": 1,
  "id": "tiktok",
  "name": "TikTok",
  "startUrl": "https://www.tiktok.com/",
  "hosts": [
    "tiktok.com"
  ],
  "color": "#111111",
  "blockAllRuleId": "tt.blockAll",
  "rules": [
    {
      "id": "tt.blockAll",
      "label": "Bloquer TikTok complètement",
      "description": "Recommandé : il n’y a rien d’autre que des vidéos courtes sur TikTok.",
      "defaultEnabled": true,
      "urls": [
        {
          "pattern": "^.*$",
          "redirectTo": null
        }
      ]
    }
  ]
}
